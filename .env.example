# RoadSense AI — Environment Configuration
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Anthropic AI assessment (optional)
# Leave ANTHROPIC_API_KEY unset to run in deterministic-only mode.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# AI_ASSESSMENT_TIMEOUT=30
# AI_ASSESSMENT_ENABLED=true

# ---------------------------------------------------------------------------
# Database (Member 1 owns the migration configuration)
# ---------------------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///./roadsense.db

# ---------------------------------------------------------------------------
# Scoring policy
# ---------------------------------------------------------------------------
# POLICY_VERSION=1.0.0
